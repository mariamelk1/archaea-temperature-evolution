################################################################
# **Modélisation de l’évolution corrélée du contenu en GC de l’ARN ribosomique (ARNr) et de la température optimale de croissance (OGT) chez les Archées**  
################################################################

# --------------------------------------------------
# Data
# --------------------------------------------------

data <- readDiscreteCharacterData("data/archaea.nex")

n_species  <- data.ntaxa()
n_nodes    <- 2 * n_species - 1

taxa <- data.taxa()
moves = VectorMoves()

# --------------------------------------------------
# Arbre phylogenetique 
# --------------------------------------------------

tree <- readTrees("data/archaea.tree")[1]

# --------------------------------------------------
# Données combinées de température et de contenu en GC (uniquement pour les espèces actuelles aux extrémités de l’arbre).
# column 1 = Temp (degrees C), column 2 = GC (%)
# --------------------------------------------------

tg_data <- readContinuousCharacterData("data/archaea_temp_gc.nex")


# --------------------------------------------------
# Mouvement brownien sur le logarithme de la température
# --------------------------------------------------

sigma_T ~ dnExponential(1.0)
moves.append(mvScale(sigma_T, weight=1.0))

# --------------------------------------------------
# Régression du contenu en GC en fonction des variations de température (évolution corrélée)
# --------------------------------------------------

beta ~ dnNormal(0.0, 10.0)
moves.append(mvSlide(beta, weight=1.0))

sigma_GC ~ dnExponential(1.0)
moves.append(mvScale(sigma_GC, weight=1.0))

# --------------------------------------------------
# valeurs a la racine
# --------------------------------------------------

nodelogT[n_nodes] ~ dnNormal(mean=ln(75), sd=5)
moves.append(mvSlide(nodelogT[n_nodes], weight=1.0))
nodeT[n_nodes]  := exp(nodelogT[n_nodes])
rootTemp := nodeT[n_nodes] # juste pour laffichage dans tracer 


nodeLogitGC[n_nodes] ~ dnNormal(0, 1)
moves.append(mvSlide(nodeLogitGC[n_nodes], weight=1.0, delta=0.1))
nodeGC[n_nodes] := Probability(1 / (1 + exp(-nodeLogitGC[n_nodes])))

rootGC := nodeGC[n_nodes] # juste pour laffichage dans tracer 



# --------------------------------------------------
# Récursion de la racine vers les feuilles de l’arbre
# --------------------------------------------------

for (i in (n_nodes-1):1) {

    # log-temperature: pure Brownian motion
    nodelogT[i] ~ dnNormal(
        mean = nodelogT[tree.parent(i)],
        sd   = sigma_T * sqrt(tree.branchLength(i))
    )

    # GC content: Brownian motion + linear regression on the
    # temperature change along the same branch
    nodeLogitGC[i] ~ dnNormal(
        mean = nodeLogitGC[tree.parent(i)]
               + beta * (nodelogT[i] - nodelogT[tree.parent(i)]),
        sd = sigma_GC * sqrt(tree.branchLength(i))
    )

    nodeGC[i] := Probability(1 / (1 + exp(-nodeLogitGC[i])))
    nodeT[i]  := exp(nodelogT[i]) 


    if (i > n_species) {
        moves.append(mvSlide(nodelogT[i], weight=1.0))
        moves.append(mvSlide(nodeLogitGC[i], weight=1.0, delta=0.1))
    }
}


# --------------------------------------------------
# Clamp sur les valeurs observées de la température ET du contenu en GC aux extrémités de l’arbre (espèces actuelles)
# --------------------------------------------------

for (i in 1:n_species) {

    taxon_name = tree.nodeName(i)
    taxon_index = tg_data.taxonIndex(taxon_name)

    obs_temp = tg_data.get(taxon_index, 1)
    obs_gc   = tg_data.get(taxon_index, 2)

    nodelogT[i].clamp( ln(obs_temp) )
    nodeLogitGC[i].clamp( logit(obs_gc) )
}






# --------------------------------------------------
# Model
# --------------------------------------------------

my_model = model(tree)

# --------------------------------------------------
# Monitors
# --------------------------------------------------

monitors = VectorMonitors()
monitors.append(mnModel(filename="analyses/archaea_simple.log", printgen=10, separator=TAB))
monitors.append(mnScreen(printgen=100, sigma_T, sigma_GC, beta, rootTemp, rootGC))

# --------------------------------------------------
# MCMC
# --------------------------------------------------

analysis = mcmc(my_model, monitors, moves)
analysis.run(generations=100000)